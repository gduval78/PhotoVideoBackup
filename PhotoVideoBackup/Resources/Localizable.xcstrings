    "Pick a folder in iCloud Drive (Files → iCloud Drive). iCloud is slow and depends on iOS and your iCloud space." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a folder in iCloud Drive (Files → iCloud Drive). iCloud is slow and depends on iOS and your iCloud space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier dans iCloud Drive (Fichiers → iCloud Drive). iCloud est lent et dépend d'iOS et de votre espace iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Ordner in iCloud Drive (Dateien → iCloud Drive). iCloud ist langsam und hängt von iOS und Ihrem iCloud-Speicher ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija una carpeta en iCloud Drive (Archivos → iCloud Drive). iCloud es lento y depende de iOS y de su espacio de iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una cartella in iCloud Drive (File → iCloud Drive). iCloud è lento e dipende da iOS e dallo spazio iCloud."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma pasta no iCloud Drive (Ficheiros → iCloud Drive). O iCloud é lento e depende do iOS e do seu espaço iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 iCloud Drive 中选择文件夹（“文件”→ iCloud Drive）。iCloud 较慢，取决于 iOS 和您的 iCloud 空间。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите папку в iCloud Drive («Файлы» → iCloud Drive). iCloud работает медленно и зависит от iOS и места в iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive のフォルダを選んでください（ファイル → iCloud Drive）。iCloud は低速で、iOS と iCloud の容量に左右されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive의 폴더를 선택하세요(파일 → iCloud Drive). iCloud는 느리며 iOS와 iCloud 공간에 따라 달라집니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive में कोई फ़ोल्डर चुनें (फ़ाइलें → iCloud Drive)। iCloud धीमा है और iOS तथा आपके iCloud स्पेस पर निर्भर करता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مجلدًا في iCloud Drive (الملفات ← iCloud Drive). iCloud بطيء ويعتمد على iOS ومساحة iCloud لديك."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 iCloud Drive 中選擇資料夾（「檔案」→ iCloud Drive）。iCloud 較慢，取決於 iOS 和您的 iCloud 空間。"
          }
        }
      }
    },
    "Connect your drive, then pick the folder to back up into. You can create a folder in the picker." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your drive, then pick the folder to back up into. You can create a folder in the picker."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez votre disque, puis choisissez le dossier de destination. Vous pouvez créer un dossier dans le sélecteur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie Ihr Laufwerk an und wählen Sie den Zielordner. Im Auswahldialog können Sie einen Ordner anlegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte su unidad y elija la carpeta de destino. Puede crear una carpeta en el selector."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il disco e scegli la cartella di destinazione. Puoi creare una cartella nel selettore."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue o seu disco e escolha a pasta de destino. Pode criar uma pasta no seletor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接您的驱动器，然后选择备份目标文件夹。您可以在选择器中新建文件夹。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите диск и выберите папку назначения. В окне выбора можно создать папку."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブを接続し、バックアップ先のフォルダを選んでください。選択画面でフォルダを作成することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드라이브를 연결한 다음 백업할 폴더를 선택하세요. 선택 화면에서 폴더를 만들 수 있습니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी ड्राइव कनेक्ट करें, फिर बैकअप के लिए फ़ोल्डर चुनें। आप चयनकर्ता में फ़ोल्डर बना सकते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
