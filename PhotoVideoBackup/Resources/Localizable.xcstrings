          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已連線。大檔案將分塊傳送。"
          }
        }
      }
    },
    "The server's certificate is not trusted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's certificate is not trusted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat du serveur n'est pas approuvé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat des Servers wird nicht als vertrauenswürdig eingestuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado del servidor no es de confianza."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il certificato del server non è attendibile."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado do servidor não é de confiança."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器的证书不受信任。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат сервера не является доверенным."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの証明書が信頼されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 인증서를 신뢰할 수 없습니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर का प्रमाणपत्र विश्वसनीय नहीं है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شهادة الخادم غير موثوقة."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器的證書不受信任。"
          }
        }
      }
    },
    "The server's certificate has changed. Forget the trusted certificate and test the connection again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's certificate has changed. Forget the trusted certificate and test the connection again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat du serveur a changé. Oubliez le certificat approuvé et testez de nouveau la connexion."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat des Servers hat sich geändert. Entfernen Sie das vertrauenswürdige Zertifikat und testen Sie die Verbindung erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado del servidor ha cambiado. Olvida el certificado de confianza y prueba de nuevo la conexión."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il certificato del server è cambiato. Dimentica il certificato attendibile e prova di nuovo la connessione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado do servidor mudou. Esqueça o certificado de confiança e teste novamente a ligação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器的证书已更改。请忽略已信任的证书，然后重新测试连接。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат сервера изменился. Удалите доверенный сертификат и проверьте подключение ещё раз."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーの証明書が変更されました。信頼済みの証明書を削除して、もう一度接続をテストしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버의 인증서가 변경되었습니다. 신뢰한 인증서를 삭제하고 연결을 다시 테스트하세요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर का प्रमाणपत्र बदल गया है। विश्वसनीय प्रमाणपत्र हटाएँ और कनेक्शन फिर से जाँचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت شهادة الخادم. انسَ الشهادة الموثوقة واختبر الاتصال مرة أخرى."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器的證書已更改。請忽略已信任的證書，然後重新測試連線。"
          }
        }
      }
    },
    "Untrusted certificate" : {
      "localizations" : {
