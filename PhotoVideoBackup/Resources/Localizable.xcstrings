    "The address of your WebDAV server. For Nextcloud it looks like https://your-server/remote.php/dav/files/your-name/. Only secure (https) addresses are accepted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address of your WebDAV server. For Nextcloud it looks like https://your-server/remote.php/dav/files/your-name/. Only secure (https) addresses are accepted."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse de votre serveur WebDAV. Pour Nextcloud, elle ressemble à https://votre-serveur/remote.php/dav/files/votre-nom/. Seules les adresses sécurisées (https) sont acceptées."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse Ihres WebDAV-Servers. Bei Nextcloud sieht sie so aus: https://ihr-server/remote.php/dav/files/ihr-name/. Nur sichere Adressen (https) werden akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección de tu servidor WebDAV. En Nextcloud tiene este aspecto: https://tu-servidor/remote.php/dav/files/tu-nombre/. Solo se aceptan direcciones seguras (https)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indirizzo del tuo server WebDAV. Per Nextcloud è simile a https://tuo-server/remote.php/dav/files/tuo-nome/. Sono accettati solo indirizzi sicuri (https)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O endereço do seu servidor WebDAV. No Nextcloud, é semelhante a https://o-seu-servidor/remote.php/dav/files/o-seu-nome/. Só são aceites endereços seguros (https)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV 服务器的地址。Nextcloud 的地址形如 https://你的服务器/remote.php/dav/files/你的用户名/。仅接受安全地址（https）。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес вашего сервера WebDAV. Для Nextcloud он выглядит так: https://ваш-сервер/remote.php/dav/files/ваше-имя/. Принимаются только защищённые адреса (https)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAVサーバーのアドレスです。Nextcloudの場合は https://サーバー名/remote.php/dav/files/ユーザー名/ のようになります。安全なアドレス（https）のみ使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV 서버 주소입니다. Nextcloud의 경우 https://서버주소/remote.php/dav/files/사용자이름/ 형태입니다. 보안 주소(https)만 허용됩니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके WebDAV सर्वर का पता। Nextcloud के लिए यह https://आपका-सर्वर/remote.php/dav/files/आपका-नाम/ जैसा दिखता है। केवल सुरक्षित (https) पते स्वीकार किए जाते हैं।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان خادم WebDAV الخاص بك. في Nextcloud يبدو هكذا: https://your-server/remote.php/dav/files/your-name/. تُقبل العناوين الآمنة (https) فقط."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebDAV 伺服器的地址。Nextcloud 的地址形如 https://你的伺服器/remote.php/dav/files/你的使用者名/。僅接受安全地址（https）。"
          }
        }
      }
    },
    "With two-factor authentication, create an app password in your server's security settings and use it here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With two-factor authentication, create an app password in your server's security settings and use it here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l'authentification à deux facteurs, créez un mot de passe d'application dans les réglages de sécurité de votre serveur et utilisez-le ici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie bei Zwei-Faktor-Authentifizierung in den Sicherheitseinstellungen Ihres Servers ein App-Passwort und verwenden Sie es hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la autenticación en dos pasos, crea una contraseña de aplicación en los ajustes de seguridad de tu servidor y úsala aquí."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con l'autenticazione a due fattori, crea una password per le app nelle impostazioni di sicurezza del tuo server e usala qui."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com a autenticação de dois fatores, crie uma palavra-passe de aplicação nas definições de segurança do seu servidor e utilize-a aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用双重验证时，请在服务器的安全设置中创建应用专用密码，并在此处使用。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При двухфакторной аутентификации создайте пароль приложения в настройках безопасности сервера и используйте его здесь."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2要素認証を使用している場合は、サーバーのセキュリティ設定でアプリパスワードを作成し、ここで使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2단계 인증을 사용 중이면 서버의 보안 설정에서 앱 비밀번호를 만들어 여기에 입력하세요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दो-चरणीय प्रमाणीकरण होने पर, अपने सर्वर की सुरक्षा सेटिंग में एक ऐप पासवर्ड बनाएँ और यहाँ उसका उपयोग करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند استخدام المصادقة الثنائية، أنشئ كلمة مرور للتطبيق من إعدادات الأمان في خادمك واستخدمها هنا."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啓用雙重驗證時，請在伺服器的安全設定中建立App專用密碼，並在此處使用。"
          }
        }
      }
    },
