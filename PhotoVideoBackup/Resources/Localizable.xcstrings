        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर ने इस फ़ाइल का आकार अस्वीकार कर दिया — उसकी अपलोड सीमा जाँचें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
