    "Use this when you replace the drive or its access no longer works. Files already copied stay where they are." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this when you replace the drive or its access no longer works. Files already copied stay where they are."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À utiliser quand vous remplacez le disque ou que son accès ne fonctionne plus. Les fichiers déjà copiés restent où ils sont."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie dies, wenn Sie das Laufwerk ersetzen oder der Zugriff nicht mehr funktioniert. Bereits kopierte Dateien bleiben, wo sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Úselo cuando cambie la unidad o su acceso deje de funcionar. Los archivos ya copiados se quedan donde están."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usalo quando sostituisci il disco o il suo accesso non funziona più. I file già copiati restano dove sono."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use quando substituir o disco ou o seu acesso deixar de funcionar. Os ficheiros já copiados ficam onde estão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更换驱动器或其访问权限失效时使用。已复制的文件保持原处。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте, когда вы заменили диск или доступ к нему перестал работать. Уже скопированные файлы остаются на месте."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更換驅動器或其存取權限失效時使用。已複製的檔案保持原處。"
          }
        }
      }
    },
