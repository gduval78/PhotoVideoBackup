    "Connected. Large files are sent in chunks." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connected. Large files are sent in chunks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté. Les gros fichiers sont envoyés par morceaux."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbunden. Große Dateien werden in Teilen gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectado. Los archivos grandes se envían por partes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connesso. I file di grandi dimensioni vengono inviati a blocchi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligado. Os ficheiros grandes são enviados por partes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
