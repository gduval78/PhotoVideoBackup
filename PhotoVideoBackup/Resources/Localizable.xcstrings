    "The backup settings are removed. Files already copied are not affected." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup settings are removed. Files already copied are not affected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages de la sauvegarde sont supprimés. Les fichiers déjà copiés ne sont pas touchés."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Backup-Einstellungen werden entfernt. Bereits kopierte Dateien bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan los ajustes de la copia. Los archivos ya copiados no se ven afectados."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni del backup vengono rimosse. I file già copiati non vengono toccati."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As definições da cópia são removidas. Os ficheiros já copiados não são afetados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份设置将被移除，已复制的文件不受影响。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки копии будут удалены. Уже скопированные файлы не затрагиваются."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの設定が削除されます。コピー済みのファイルには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업 설정이 삭제됩니다. 이미 복사된 파일에는 영향이 없습니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकअप की सेटिंग्स हटा दी जाती हैं। पहले से कॉपी की गई फ़ाइलों पर कोई असर नहीं पड़ता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إزالة إعدادات النسخة الاحتياطية. لا تتأثر الملفات المنسوخة مسبقًا."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份設定將被移除，已複製的檔案不受影響。"
          }
        }
      }
    },
