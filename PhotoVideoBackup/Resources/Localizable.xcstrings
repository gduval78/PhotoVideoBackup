    "Not enough free space on this device to copy this file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend freier Speicher auf diesem Gerät, um diese Datei zu kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay espacio suficiente en este dispositivo para copiar este archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace insuffisant sur cet appareil pour copier ce fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio insufficiente su questo dispositivo per copiare questo file."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço insuficiente neste dispositivo para copiar este ficheiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно свободного места на устройстве для копирования этого файла."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备可用空间不足，无法复制此文件。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末にこのファイルをコピーする空き容量がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 이 파일을 복사할 여유 공간이 부족합니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर यह फ़ाइल कॉपी करने के लिए पर्याप्त खाली जगह नहीं है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مساحة كافية على هذا الجهاز لنسخ هذا الملف."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置可用空間不足，無法複製此檔案。"
          }
        }
      }
    },
    "Not enough free space on this device. This backup needs %@ but only %@ is available. Free up space and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend freier Speicher auf diesem Gerät. Diese Sicherung benötigt %1$@, es sind aber nur %2$@ verfügbar. Geben Sie Speicher frei und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay espacio suficiente en este dispositivo. Esta copia de seguridad necesita %1$@, pero solo hay %2$@ disponibles. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace insuffisant sur cet appareil. Cette sauvegarde nécessite %1$@ alors que seulement %2$@ sont disponibles. Libérez de l’espace puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio insufficiente su questo dispositivo. Questo backup richiede %1$@ ma sono disponibili solo %2$@. Libera spazio e riprova."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço insuficiente neste dispositivo. Esta cópia de segurança precisa de %1$@, mas só há %2$@ disponíveis. Liberte espaço e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недостаточно свободного места на устройстве. Для этой резервной копии требуется %1$@, доступно только %2$@. Освободите место и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备可用空间不足。此次备份需要 %1$@，但仅有 %2$@ 可用。请释放空间后重试。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末の空き容量が足りません。このバックアップには %@ が必要ですが、空きは %@ のみです。容量を空けてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 여유 공간이 부족합니다. 이 백업에는 %@이(가) 필요하지만 %@만 사용할 수 있습니다. 공간을 확보한 후 다시 시도하세요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर पर्याप्त खाली जगह नहीं है। इस बैकअप को %@ चाहिए, पर केवल %@ उपलब्ध है। जगह खाली करें और फिर कोशिश करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مساحة كافية على هذا الجهاز. تحتاج هذه النسخة الاحتياطية إلى %@ لكن المتاح %@ فقط. حرّر مساحة وحاول مرة أخرى."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置可用空間不足。此次備份需要 %1$@，但僅有 %2$@ 可用。請釋放空間後重試。"
          }
        }
      }
    },
