    "Back up anyway" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Back up anyway"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarder quand même"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trotzdem sichern"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar de todos modos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegui comunque il backup"
          }
        },
        "pt" : {
