    "Choose what to back up and where. Then one tap is all it takes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what to back up and where. Then one tap is all it takes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quoi sauvegarder et où. Ensuite, un seul geste suffit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie, was und wohin gesichert wird. Danach genügt ein Fingertipp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija qué copiar y dónde. Después, basta con un toque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa salvare e dove. Poi basta un tocco."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que copiar e para onde. Depois, basta um toque."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要备份的内容和位置，之后只需轻点一下。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что копировать и куда. Дальше достаточно одного касания."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップする内容と保存先を選びます。あとはワンタップで実行できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업할 항목과 위치를 선택하세요. 그다음에는 한 번만 탭하면 됩니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि क्या और कहाँ बैकअप करना है। फिर बस एक टैप काफ़ी है।"
