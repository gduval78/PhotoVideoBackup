        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器上已存在同名的不同檔案。"
          }
        }
      }
    },
    "The server refused this file size — check its upload limit." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused this file size — check its upload limit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé la taille de ce fichier — vérifiez sa limite d'envoi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
