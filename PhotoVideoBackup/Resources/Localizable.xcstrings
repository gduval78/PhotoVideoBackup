    "Choose the folder of the card or drive to copy from. For a drive that already holds a backup, choose the device folder inside it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the folder of the card or drive to copy from. For a drive that already holds a backup, choose the device folder inside it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le dossier de la carte ou du disque à copier. Pour un disque qui contient déjà une sauvegarde, choisissez le dossier de l'appareil à l'intérieur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie den Ordner der Karte oder des Laufwerks, von dem kopiert wird. Bei einem Laufwerk mit vorhandenem Backup wählen Sie den Geräteordner darin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija la carpeta de la tarjeta o unidad de origen. Si la unidad ya contiene una copia, elija la carpeta del dispositivo dentro de ella."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la cartella della scheda o del disco da cui copiare. Per un disco che contiene già un backup, scegli la cartella del dispositivo al suo interno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a pasta do cartão ou disco de origem. Para um disco que já tenha uma cópia, escolha a pasta do dispositivo lá dentro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择要复制的存储卡或驱动器文件夹。对于已有备份的驱动器，请选择其中的设备文件夹。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите папку карты или диска, откуда копировать. Для диска, где уже есть копия, выберите внутри него папку устройства."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピー元のカードまたはドライブのフォルダを選んでください。すでにバックアップが入っているドライブの場合は、その中のデバイスフォルダを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사할 카드 또는 드라이브의 폴더를 선택하세요. 이미 백업이 들어 있는 드라이브라면 그 안의 기기 폴더를 선택하세요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कॉपी करने के लिए कार्ड या ड्राइव का फ़ोल्डर चुनें। जिस ड्राइव में पहले से बैकअप है, उसके अंदर का डिवाइस फ़ोल्डर चुनें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مجلد البطاقة أو القرص المراد النسخ منه. إذا كان القرص يحتوي بالفعل على نسخة احتياطية، فاختر مجلد الجهاز بداخله."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇要複製的記憶卡或驅動器資料夾。對於已有備份的驅動器，請選擇其中的裝置資料夾。"
          }
        }
      }
    },
