        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーがこのファイルサイズを拒否しました。アップロード上限を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 이 파일 크기를 거부했습니다. 업로드 한도를 확인하세요."
