          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نقطة بداية. ستختار القرص أو المجلد في الخطوة التالية."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇一個起點。下一步再選擇驅動器或資料夾。"
          }
        }
      }
    },
