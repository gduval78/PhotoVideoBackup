          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключено. Большие файлы отправляются частями."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続しました。大きなファイルは分割して送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결되었습니다. 큰 파일은 나누어 전송됩니다."
