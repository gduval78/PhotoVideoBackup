    "The Advanced screens show every source, destination and detail. Most people only need the Backups tab." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Advanced screens show every source, destination and detail. Most people only need the Backups tab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écrans avancés montrent chaque source, destination et détail. La plupart des gens n'ont besoin que de l'onglet Sauvegardes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erweiterten Bildschirme zeigen jede Quelle, jedes Ziel und jedes Detail. Die meisten brauchen nur den Tab „Backups“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas avanzadas muestran cada origen, destino y detalle. La mayoría solo necesita la pestaña Copias."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le schermate avanzate mostrano ogni origine, destinazione e dettaglio. La maggior parte delle persone ha bisogno solo della scheda Backup."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ecrãs avançados mostram cada origem, destino e detalhe. A maioria só precisa do separador Cópias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级界面会显示每个来源、目标位置和详细信息。大多数人只需使用“备份”标签页。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расширенные экраны показывают каждый источник, место назначения и подробности. Большинству достаточно вкладки «Копии»."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高級介面會顯示每個來源、目的地和詳細資訊。大多數人只需使用「備份」標籤頁。"
          }
        }
      }
    },
