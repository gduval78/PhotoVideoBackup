    "The phone is not charging yet: connect the power source or the backup will not start." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléphone n’est pas encore en charge : branchez la source d’alimentation, sinon la sauvegarde ne démarrera pas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Telefon lädt noch nicht: Schließen Sie die Stromquelle an, sonst startet das Backup nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El móvil aún no está cargando: conecta la fuente de alimentación o la copia no se iniciará."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono non è ancora in carica: collega la fonte di alimentazione, altrimenti il backup non partirà."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O telemóvel ainda não está a carregar: ligue a fonte de alimentação, senão a cópia não arranca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机尚未充电：请连接电源，否则备份不会启动。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон ещё не заряжается: подключите источник питания, иначе копирование не начнётся."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートフォンはまだ充電されていません。電源を接続しないと、バックアップは開始されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이 아직 충전 중이 아닙니다. 전원을 연결하지 않으면 백업이 시작되지 않습니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन अभी चार्ज नहीं हो रहा है: बिजली का स्रोत जोड़ें, वरना बैकअप शुरू नहीं होगा।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهاتف لا يشحن بعد: صِل مصدر الطاقة وإلا فلن يبدأ النسخ الاحتياطي."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手機尚未充電：請連線電源，否則備份不會啓動。"
          }
        }
      }
    },
