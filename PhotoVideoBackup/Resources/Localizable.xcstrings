    "Permanently deletes the %@ files that were copied during this session from the original source. Your backup is not affected." : {
      "comment" : "A description of the action of permanently deleting files.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht dauerhaft die %@ Dateien, die während dieser Sitzung von der Originalquelle kopiert wurden. Ihre Sicherung ist nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes the %@ files that were copied during this session from the original source. Your backup is not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente los %@ archivos copiados durante esta sesión desde la fuente original. Su copia de seguridad no se ve afectada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement les %@ fichiers copiés pendant cette session depuis la source d'origine. Votre sauvegarde n'est pas affectée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente i %@ file copiati durante questa sessione dalla sorgente originale. Il tuo backup non verrà modificato."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente os %@ ficheiros copiados durante esta sessão da fonte original. O seu backup não é afetado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безвозвратно удаляет %@ файлов, скопированных в этом сеансе, из источника. Резервная копия не затрагивается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从原始来源中永久删除本次会话中复制的 %@ 个文件。您的备份不受影响。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションでコピーされた %@ 個のファイルを元のソースから完全に削除します。バックアップには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션에서 복사된 파일 %@개를 원본 소스에서 영구적으로 삭제합니다. 백업에는 영향이 없습니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सत्र में कॉपी की गई %@ फ़ाइलें मूल स्रोत से हमेशा के लिए हटा दी जाती हैं। आपके बैकअप पर कोई असर नहीं पड़ता।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف نهائيًا من المصدر الأصلي الملفات البالغ عددها %@ التي نُسخت في هذه الجلسة. لا تتأثر نسختك الاحتياطية."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將從原始來源中永久刪除本次會話中複製的 %@ 個檔案。您的備份不受影響。"
          }
        }
      }
    },
