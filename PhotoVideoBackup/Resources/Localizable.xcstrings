    "Choose a starting point. You pick the drive or folder in the next step." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a starting point. You pick the drive or folder in the next step."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un point de départ. Vous désignerez le disque ou le dossier à l'étape suivante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie einen Ausgangspunkt. Laufwerk oder Ordner wählen Sie im nächsten Schritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija un punto de partida. Elegirá la unidad o carpeta en el paso siguiente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un punto di partenza. Il disco o la cartella si scelgono nel passaggio successivo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um ponto de partida. Escolherá o disco ou a pasta no passo seguinte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择一个起点。下一步再选择驱动器或文件夹。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите отправную точку. Диск или папку вы выберете на следующем шаге."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始点を選んでください。ドライブまたはフォルダは次の手順で選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작점을 선택하세요. 드라이브나 폴더는 다음 단계에서 선택합니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
