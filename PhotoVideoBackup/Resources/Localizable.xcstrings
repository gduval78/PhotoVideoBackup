    "This folder is in iCloud Drive. iCloud is slow and depends on iOS and your iCloud space." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This folder is in iCloud Drive. iCloud is slow and depends on iOS and your iCloud space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier est dans iCloud Drive. iCloud est lent et dépend d'iOS et de votre espace iCloud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner liegt in iCloud Drive. iCloud ist langsam und hängt von iOS und Ihrem iCloud-Speicher ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta carpeta está en iCloud Drive. iCloud es lento y depende de iOS y de su espacio de iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa cartella è in iCloud Drive. iCloud è lento e dipende da iOS e dallo spazio iCloud."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pasta está no iCloud Drive. O iCloud é lento e depende do iOS e do seu espaço iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта папка находится в iCloud Drive. iCloud работает медленно и зависит от iOS и места в iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダは iCloud Drive にあります。iCloud は低速で、iOS と iCloud の容量に左右されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더는 iCloud Drive에 있습니다. iCloud는 느리며 iOS와 iCloud 공간에 따라 달라집니다."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह फ़ोल्डर iCloud Drive में है। iCloud धीमा है और iOS तथा आपके iCloud स्पेस पर निर्भर करता है।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المجلد موجود في iCloud Drive. iCloud بطيء ويعتمد على iOS ومساحة iCloud لديك."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹位于 iCloud Drive 中。iCloud 较慢，取决于 iOS 和您的 iCloud 空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資料夾位於 iCloud Drive 中。iCloud 較慢，取決於 iOS 和您的 iCloud 空間。"
          }
        }
      }
    },
    "The server refused the credentials. With two-factor authentication, use an app password." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server refused the credentials. With two-factor authentication, use an app password."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé les identifiants. Avec l'authentification à deux facteurs, utilisez un mot de passe d'application."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Zugangsdaten abgelehnt. Verwenden Sie bei Zwei-Faktor-Authentifizierung ein App-Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor rechazó las credenciales. Con la autenticación en dos pasos, usa una contraseña de aplicación."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server ha rifiutato le credenziali. Con l'autenticazione a due fattori, usa una password per le app."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor recusou as credenciais. Com a autenticação de dois fatores, utilize uma palavra-passe de aplicação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器拒绝了凭据。启用双重验证时，请使用应用专用密码。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер отклонил учётные данные. При двухфакторной аутентификации используйте пароль приложения."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが認証情報を拒否しました。2要素認証を使用している場合は、アプリパスワードを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버가 자격 증명을 거부했습니다. 2단계 인증을 사용 중이면 앱 비밀번호를 사용하세요."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सर्वर ने क्रेडेंशियल अस्वीकार कर दिए। दो-चरणीय प्रमाणीकरण होने पर ऐप पासवर्ड का उपयोग करें।"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض الخادم بيانات الاعتماد. عند استخدام المصادقة الثنائية، استخدم كلمة مرور للتطبيق."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器拒絕了憑據。啓用雙重驗證時，請使用App專用密碼。"
          }
        }
      }
    },
    "A different file already exists at this name on the server." : {
      "localizations" : {
